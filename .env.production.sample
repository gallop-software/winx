# ===========================================
# Production Environment
# ===========================================
# Rename this file to .env.production, then fill in your values.
#
# Cloudflare:  npm run cf:secrets   (pushes all values here to the Worker's secret store)
#
# NEXT_PUBLIC_* is inlined at build time, from this file. Everything else is
# read at runtime from the Worker's secret store — a committed file is NOT
# read at runtime.
# ===========================================

NEXT_PUBLIC_PRODUCTION_URL=https://yourdomain.com
NEXT_PUBLIC_WORDPRESS_URL=https://your-wordpress-instance.com

# Contact form mail (submit-form API), sent through Cloudflare Email Sending
# with the EMAIL binding in wrangler.jsonc. There is no API key.
# EMAIL_FROM must be on the domain enabled for sending:
#   npx wrangler email sending enable cf.yourdomain.com
EMAIL_FROM=contact@cf.yourdomain.com
EMAIL_FROM_NAME="Your Business"
# Receives contact form messages.
EMAIL_TO=contact@yourdomain.com
# Optional. Gets a copy of every message.
# EMAIL_BCC=you@example.com

# Marketing email (the envelope button on a post, administrators only).
# Replies to a mailing go to EMAIL_TO. Set this only to send them elsewhere.
# EMAIL_REPLY_TO=you@example.com
# The publisher's postal address, shown in the footer of every mailing. The
# law on marketing email (CAN-SPAM) requires one.
EMAIL_POSTAL_ADDRESS="Your Business, 123 Main St, City, ST 00000"

# Comments and members. The key the site sends to WordPress to save a
# visitor's comment and to log members in, sign them up, and save their
# profiles. Generate it in WordPress under Gallop > Settings > Front-end
# connection, and tick "Submit comments" and "Manage members" there. Without
# it comments are still shown, and the comment form and the login button are
# not. Never give it a NEXT_PUBLIC_ name: that would publish it.
GALLOP_WP_API_KEY=

# Cloudflare R2 CDN (for Studio image sync)
CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_PUBLIC_URL=https://your-cdn-domain.com

# The database is Cloudflare D1, bound to the Worker as DB in wrangler.jsonc.
# It needs no connection string. Apply migrations with: npm run db:migrate

# FlowTrace: who is emailed about each visit that converts (the contact
# form, a newsletter sign-up, a new account, an email link), comma-separated.
# Each of them chooses in FlowTrace's Email settings: every visit, a daily or
# weekly summary, or none. Empty: EMAIL_TO alone.
FLOWTRACE_EMAILS=

# The admin toolbar demo: true adds a "Try the admin toolbar" button that
# shows anyone the toolbar with made-up subscribers, campaigns and stats.
# Keep it false on your own site; it is for the template's showcase.
NEXT_PUBLIC_ADMIN_DEMO=false

# Optional. Google Analytics 4 measurement id (G-XXXXXXX) and Google Ads id
# (AW-XXXXXXX); leave empty for neither. The site counts its own page views
# either way (the admin toolbar's Analytics).
NEXT_PUBLIC_GOOGLE_ANALYTICS=
NEXT_PUBLIC_GOOGLE_ADS_ID=
