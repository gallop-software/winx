{
  "name": "winx",
  "version": "1.0.7",
  "private": true,
  "description": "Founder Notes \u2014 an independent publication for startup founders, with essays on product strategy, fundraising, hiring, and the day-to-day work of building an early-stage company.",
  "homepage": "https://winx.gallop.software",
  "author": {
    "name": "Gallop",
    "url": "https://gallop.software"
  },
  "contributors": [
    {
      "name": "Chris Baldelomar",
      "url": "https://github.com/webplantmedia"
    },
    {
      "name": "Niel Wostan",
      "url": "https://github.com/NielWostan"
    }
  ],
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "npm run pages && next build",
    "postinstall": "prisma generate",
    "db:generate": "npx prisma generate",
    "db:migrate": "wrangler d1 migrations apply winx --remote",
    "db:migrate:local": "wrangler d1 migrations apply winx --local",
    "start": "next start",
    "lint": "eslint src/",
    "lint:file": "eslint",
    "prettier": "prettier --write .",
    "ts": "tsc --noEmit",
    "lint:next": "eslint src/ --rule 'gallop/no-client-blocks: off' --rule 'gallop/no-container-in-section: off' --rule 'gallop/prefer-component-props: off'",
    "lint:gallop": "eslint 'src/app/**/_blocks/' --rule 'gallop/no-client-blocks: warn' --rule 'gallop/no-container-in-section: warn' --rule 'gallop/prefer-component-props: warn'",
    "audit": "gallop audit",
    "audit:strict": "gallop audit --strict",
    "audit:json": "gallop audit --json",
    "blocks": "node _scripts/generate-block-index.mjs",
    "pages": "node _scripts/generate-page-metadata.mjs",
    "cf:setup": "cp -n .env.production.sample .env.production 2>/dev/null; echo 'Edit .env.production, then run: npm run cf:secrets (push secrets) and deploy'",
    "cf:build": "npm run pages && opennextjs-cloudflare build",
    "cf:preview": "cp .env.production .dev.vars 2>/dev/null; npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy && npm run cf:clear-pages",
    "cf:clear-pages": "wrangler kv key put --binding POST_CACHE --remote meta:pages-cleared-at \"$(node -e 'process.stdout.write(String(Date.now()))')\"",
    "cf:upload": "npm run cf:build && opennextjs-cloudflare upload",
    "cf:secrets": "wrangler secret bulk .env.production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "refresh": "rm -rf node_modules .next && npm install",
    "clean": "rm -rf node_modules .next package-lock.json && npm install",
    "update:check": "npx npm-check-updates",
    "update:patch": "npx npm-check-updates -u --target patch && npm run clean",
    "update:minor": "npx npm-check-updates -u --target minor && npm run clean",
    "update:major": "npx npm-check-updates -u --target latest && npm run clean",
    "update:interactive": "npx npm-check-updates -i",
    "update:doctor": "npx npm-check-updates --doctor -u",
    "unused": "knip",
    "check": "npm run lint && npm run ts"
  },
  "dependencies": {
    "@algolia/autocomplete-core": "^1.19.8",
    "@headlessui/react": "^2.2.10",
    "@iconify/icons-heroicons": "^1.2.9",
    "@iconify/icons-lucide": "^1.2.135",
    "@iconify/icons-mdi": "^1.2.48",
    "@iconify/icons-simple-icons": "^1.2.74",
    "@iconify/types": "^2.0.0",
    "@next/third-parties": "^16.2.4",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "html-react-parser": "^6.0.1",
    "luxon": "^3.7.2",
    "next": "^16.2.4",
    "react": "^19",
    "react-dom": "^19.2.5",
    "react-intersection-observer": "^10.0.3",
    "server-only": "^0.0.1",
    "swiper": "^12.1.4",
    "valtio": "^2.3.1",
    "yet-another-react-lightbox": "^3.31.0"
  },
  "devDependencies": {
    "@gallop.software/canon": "^2.34.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "knip": "^5.88.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
}
